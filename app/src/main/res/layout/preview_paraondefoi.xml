<?xml version="1.0" encoding="utf-8"?>
<!--
    Prévia do seletor de widgets. Conteúdo FIXO de propósito: o launcher infla este layout sem
    tocar no app, então não há dado real a mostrar — e um valor plausível diz mais sobre o widget
    do que um "R$ 0,00" que parece defeito. As cores vêm de `values/colors.xml`, espelho de
    `CoresWidget` (ver o comentário lá).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/preview_cartao"
    android:padding="12dp">
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="para onde foi"
        android:textColor="@color/widget_secundario"
        android:textSize="11sp" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="10dp"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">
    <View
        android:layout_width="0dp"
        android:layout_height="10dp" android:layout_weight="4"
        android:background="@color/widget_board_pos3" />
    <View
        android:layout_width="0dp"
        android:layout_height="10dp" android:layout_weight="3"
        android:background="@color/widget_board_pos2" />
    <View
        android:layout_width="0dp"
        android:layout_height="10dp" android:layout_weight="2"
        android:background="@color/widget_outras" />
    <View
        android:layout_width="0dp"
        android:layout_height="10dp" android:layout_weight="1"
        android:background="@color/widget_trilha" />
    </LinearLayout>
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="mercado · casa · lazer"
        android:textColor="@color/widget_secundario"
        android:textSize="11sp" />
</LinearLayout>
