<?xml version="1.0" encoding="utf-8"?>
<!--
    Prévia do seletor de widgets. Conteúdo FIXO de propósito: o launcher infla este layout sem
    tocar no app, então não há dado real a mostrar — e um valor plausível diz mais sobre o widget
    do que um "R$ 0,00" que parece defeito. As cores vêm de `values/colors.xml`, espelho de
    `CoresWidget` (ver o comentário lá).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/preview_cartao"
    android:padding="12dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:background="@drawable/preview_pill"
            android:gravity="center"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:text="− saída"
            android:textColor="@color/widget_sobre_container"
            android:textSize="13sp"
            android:textStyle="bold" />
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/preview_pill"
            android:gravity="center"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:text="+ entrada"
            android:textColor="@color/widget_sobre_container"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
