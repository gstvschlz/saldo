<?xml version="1.0" encoding="utf-8"?>
<!--
    Nasce 4x2 e encolhe ate 2x2 (minResize* abaixo de min*): no compacto o cabecalho empilha e
    a lista cai para duas fatias. A largura importa mais que a altura aqui — a barra e
    calculada em dp a partir da largura viva do widget.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="250dp"
    android:minHeight="110dp"
    android:minResizeWidth="110dp"
    android:minResizeHeight="110dp"
    android:maxResizeWidth="400dp"
    android:maxResizeHeight="220dp"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:resizeMode="horizontal|vertical"
    android:updatePeriodMillis="21600000"
    android:widgetCategory="home_screen"
    android:description="@string/widget_paraondefoi_descricao"
    android:initialLayout="@layout/glance_default_loading_layout" />
