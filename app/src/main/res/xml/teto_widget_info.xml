<?xml version="1.0" encoding="utf-8"?>
<!--
    4x1: uma linha so - o teto, o rotulo e o que resta. Como o do ritmo, precisa de
    LARGURA e nao de altura, senao o "restam R$ ..." nao cabe ao lado do numero.
-->
<!--
    `previewLayout` só existe no Android 12+, e é isso mesmo: a decisão foi prévia em XML,
    sem `previewImage` de vetor para as versões antigas. Abaixo do 12 o seletor mostra o
    ícone, como sempre mostrou.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="UnusedAttribute"
    android:minWidth="250dp"
    android:minHeight="60dp"
    android:minResizeWidth="250dp"
    android:minResizeHeight="60dp"
    android:maxResizeWidth="400dp"
    android:maxResizeHeight="110dp"
    android:targetCellWidth="4"
    android:targetCellHeight="1"
    android:resizeMode="horizontal|vertical"
    android:updatePeriodMillis="21600000"
    android:widgetCategory="home_screen"
    android:description="@string/widget_teto_descricao"
    android:initialLayout="@layout/glance_default_loading_layout"
    android:previewLayout="@layout/preview_teto" />
