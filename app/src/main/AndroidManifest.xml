<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Único pedido novo: os lembretes são notificações locais. Nada de alarme exato nem boot. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
        A promessa do "100% local" da tela "mais". `allowBackup="false"` sozinho não
        fecha a porta: a partir do Android 12 quem decide backup em nuvem e transferência
        entre aparelhos é o dataExtractionRules, e o arquivo que vinha do template deixava
        os dois blocos vazios — ou seja, liberados. Os três atributos juntos negam a saída
        de dados em toda a faixa de minSdk 26..37.
    -->
    <application
        android:name=".SaldoApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.Saldo">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTop"
            android:theme="@style/Theme.Saldo">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            A captura de notificações. O acesso NÃO se pede por diálogo: o usuário liga à
            mão em Configurações > Acesso a notificações, e a tela `mais > notificações`
            abre essa página do sistema e mostra o estado real.
        -->
        <service
            android:name=".captura.EscutaNotificacoes"
            android:exported="false"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Os botões "lançar" e "ignorar". Interno: ninguém de fora pode lançar por você. -->
        <receiver
            android:name=".captura.AcoesSugestao"
            android:exported="false" />

        <receiver
            android:name=".widget.SaldoWidgetProvider"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/saldo_widget_info" />
        </receiver>
        <receiver
            android:name=".widget.ACaminhoWidgetReceiver"
            android:exported="true"
            android:label="saldo · a caminho">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/acaminho_widget_info" />
        </receiver>
        <receiver
            android:name=".widget.ParaOndeFoiWidgetReceiver"
            android:exported="true"
            android:label="saldo · para onde foi">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/paraondefoi_widget_info" />
        </receiver>
        <receiver
            android:name=".widget.BoardWidgetReceiver"
            android:exported="true"
            android:label="saldo · board">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/board_widget_info" />
        </receiver>
        <receiver
            android:name=".widget.RitmoWidgetReceiver"
            android:exported="true"
            android:label="saldo · ritmo">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/ritmo_widget_info" />
        </receiver>
        <receiver
            android:name=".widget.TetoWidgetReceiver"
            android:exported="true"
            android:label="saldo · hoje">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/teto_widget_info" />
        </receiver>
        <receiver
            android:name=".widget.PoupancaWidgetReceiver"
            android:exported="true"
            android:label="saldo · poupança">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/poupanca_widget_info" />
        </receiver>
        <receiver
            android:name=".widget.LancarWidgetReceiver"
            android:exported="true"
            android:label="saldo · lançar">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/lancar_widget_info" />
        </receiver>
    </application>

</manifest>
